diff --git a/pexpert/pexpert/arm64/CEPHEUS.h b/pexpert/pexpert/arm64/CEPHEUS.h
new file mode 100644
index 0000000..e2aa968
--- /dev/null
+++ b/pexpert/pexpert/arm64/CEPHEUS.h
@@ -0,0 +1,17 @@
+/*
+ * Board config for the Xiaomi Mi 9 ("cepheus", Qualcomm SM8150 / Snapdragon 855):
+ * Kryo 485 (1 prime + 3 gold + 4 silver Cortex-A76/A55), ARMv8.2, no PAC.
+ *
+ * Same interrupt model as SWEET: the TrustZone-owned GIC Group 0 and the
+ * virtual timer on PPI 3 (INTID 19), so the SWEET code paths are reused.
+ * The SM8150 timer node in the SoC DTB has the same PPI layout (checked).
+ */
+
+#ifndef _PEXPERT_ARM64_CEPHEUS_H
+#define _PEXPERT_ARM64_CEPHEUS_H
+
+#include <pexpert/arm64/SWEET.h>
+
+#define CEPHEUS                   1
+
+#endif /* ! _PEXPERT_ARM64_CEPHEUS_H */
