diff -ruN a/BootShim/BootShim.S b/BootShim/BootShim.S
--- a/BootShim/BootShim.S	2026-10-25 20:46:11.130609708 +0000
+++ b/BootShim/BootShim.S	2026-10-25 20:46:11.131896931 +0000
@@ -7,7 +7,7 @@
   .quad FD_BASE         /* Text Offset */
 
 _StackSize:
-  .quad FD_SIZE         /* Image Size */
+  .quad FD_SIZE + (_Payload - _Head) /* Complete shim and payload */
   .quad 0               /* Flags */
   .quad 0               /* Reserved */
   .quad 0               /* Reserved */
@@ -31,12 +31,33 @@
   ldr   x5, =FD_BASE
 
 _Entry:
+  /* Publish the copied instructions before executing them. */
+  dsb   sy
+  mrs   x9, ctr_el0
+  ubfx  x9, x9, #16, #4
+  mov   x10, #4
+  lsl   x9, x10, x9
+  sub   x10, x9, #1
+  bic   x8, x5, x10
+  ldr   x7, =FD_SIZE
+  add   x7, x5, x7
+
+_CleanLoop:
+  dc    cvac, x8
+  add   x8, x8, x9
+  cmp   x8, x7
+  b.lo  _CleanLoop
+  dsb   sy
+  ic    iallu
+  dsb   sy
+  isb
   br    x5
 
 _Dead:
   b     _Dead
 
 .text
+.ltorg
 .align 4
 
 _Payload:
