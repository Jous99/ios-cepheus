diff --git a/bsd/dev/cepheus_ts.c b/bsd/dev/cepheus_ts.c
index 23ad81c..2eaf614 100644
--- a/bsd/dev/cepheus_ts.c
+++ b/bsd/dev/cepheus_ts.c
@@ -14,7 +14,7 @@
  *   2  + vote the wrapper 2 AHB clocks and the SE0 clock, initialise the GENI engine. No I2C.
  *   3  + release reset and read the FTS event FIFO for 1.5 s, logging every event.
  *   4  + sense on (0x93), poll the IRQ line and report touches to iOS (cepheus_hid_touch).
- * cepheustsdelay=S: seconds after boot before starting (default 60).
+ * cepheustsdelay=S: seconds after boot before starting (default 120, so the USB live log is already up).
  * Use with cepheustouch=0: the old driver pokes registers of another SoC.
  */
 #if defined(ARM64_BOARD_CONFIG_CEPHEUS)
@@ -42,6 +42,9 @@ void cepheus_ts_init(void);
 #define TS_BR_MAHB      0x1e004u
 #define TS_BR_SAHB      0x1e008u
 #define TS_BR_SE0       0x1e144u
+#define TS_CBCR_ENABLE  (1u << 0)
+#define TS_CBCR_HWCG    (1u << 1)            /* hwcg_bit of gcc_qupv3_wrap_2_s_ahb_clk */
+#define TS_CBCR_OFF     (1u << 31)
 #define TS_MAX          10u
 #define TS_FIFO_READ    0x85u
 #define TS_CMD_SENSE_ON 0x93u
@@ -241,13 +244,28 @@ ts_clocks(uint32_t *level)
 			return false;
 		}
 	}
+	/*
+	 * gcc_qupv3_wrap_2_s_ahb_clk has hardware clock gating (hwcg_bit 1): it reads "off" (0x80000002) while idle even
+	 * with the vote set, unlike m_ahb and se0. Force it on (CLK_ENABLE, HWCG off) and continue only when the branch
+	 * really reports on; a read of a clock-gated GENI block would hang the bus.
+	 */
+	uint32_t sahb = ts_rd(ts.gcc, TS_BR_SAHB);
+	if (sahb & TS_CBCR_OFF) {
+		printf("CEPHEUS TS: s_ahb reports off (%#x) with the vote set; forcing CLK_ENABLE and HWCG off\n", sahb);
+		ts_wr(ts.gcc, TS_BR_SAHB, (sahb & ~(TS_CBCR_OFF | TS_CBCR_HWCG)) | TS_CBCR_ENABLE);
+	}
 	const uint32_t branches[] = { TS_BR_MAHB, TS_BR_SAHB, TS_BR_SE0 };
 	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
-		if (!ts_wait_clear(ts.gcc, branches[i], 1u << 31)) {
+		if (!ts_wait_clear(ts.gcc, branches[i], TS_CBCR_OFF)) {
 			printf("CEPHEUS TS: GCC branch %#x still halted (%#x)\n", branches[i], ts_rd(ts.gcc, branches[i]));
+			if (branches[i] == TS_BR_SAHB) {
+				ts_wr(ts.gcc, TS_BR_SAHB, sahb & ~TS_CBCR_OFF);          /* undo the force */
+			}
 			return false;
 		}
 	}
+	printf("CEPHEUS TS: clocks on: m_ahb %#x s_ahb %#x se0 %#x\n", ts_rd(ts.gcc, TS_BR_MAHB), ts_rd(ts.gcc, TS_BR_SAHB),
+	    ts_rd(ts.gcc, TS_BR_SE0));
 	return true;
 }
 
