-/* Which window an address belongs to: 1 = GCC, 2 = gpucc, 3 = GMU, 0 = none. */
+/*
+ * G2a: read only inventory of the GPU SMMU, in steps so that a protected register shows where it is (the log names what
+ * is about to be read before reading it). Field positions come from Linux arm-smmu.h; the context banks start at page
+ * (1 << (NUMPAGENDXB + 1)) of the SMMU, global registers 0 and 1 are pages 0 and 1.
+ */
+struct gpu_smmu_geo {
+	unsigned numsmrg, numcb, pgshift, numpage;
+};
+
+static uint32_t
+gpu_srd(uint32_t off)
+{
+	return gpu_rd(gpu_smmu, off);
+}
+
+static bool
+gpu_smmu_ok(void)
+{
+	if (!gpu_gmu_readable()) {
+		printf("CEPHEUS GPU: smmu: el dominio CX esta apagado (ejecuta g g1 antes)\n");
+		return false;
+	}
+	return true;
+}
+
+static bool
+gpu_smmu_geo(struct gpu_smmu_geo *g)
+{
+	uint32_t id0 = gpu_srd(0x20u), id1 = gpu_srd(0x24u);
+	if (id0 == 0 || id0 == 0xffffffffu || id1 == 0 || id1 == 0xffffffffu) {
+		printf("CEPHEUS GPU: smmu: IDR0 = %08x, IDR1 = %08x no son validos: no se sigue\n", id0, id1);
+		return false;
+	}
+	g->numsmrg = id0 & 0xffu;
+	g->numcb = id1 & 0xffu;
+	g->pgshift = (id1 & (1u << 31)) ? 16u : 12u;
+	g->numpage = 1u << (((id1 >> 28) & 7u) + 1);
+	return true;
+}
+
+static void
+gpu_smmu_global(void)
+{
+	static const unsigned bits[8] = { 32, 36, 40, 42, 44, 48, 48, 48 };
+	struct gpu_smmu_geo g;
+	if (!gpu_smmu_ok()) {
+		return;
+	}
+	printf("CEPHEUS GPU: === G2a: SMMU de la GPU (0x2ca0000), registros globales ===\n");
+	printf("CEPHEUS GPU: smmu: leyendo IDR0 (0x20)\n");
+	if (!gpu_smmu_geo(&g)) {
+		return;
+	}
+	uint32_t id0 = gpu_srd(0x20u), id1 = gpu_srd(0x24u), id2 = gpu_srd(0x28u), id7 = gpu_srd(0x3cu);
+	printf("CEPHEUS GPU: smmu IDR0 = %08x  NUMSMRG=%u S1TS=%u S2TS=%u NTS=%u SMS=%u CTTW=%u\n", id0, g.numsmrg, (id0 >> 30) & 1u,
+	    (id0 >> 29) & 1u, (id0 >> 28) & 1u, (id0 >> 27) & 1u, (id0 >> 14) & 1u);
+	printf("CEPHEUS GPU: smmu IDR1 = %08x  NUMCB=%u paginas de %u KiB, NUMPAGENDXB=%u (bancos desde la pagina %u)\n", id1, g.numcb,
+	    1u << (g.pgshift - 10), (id1 >> 28) & 7u, g.numpage);
+	printf("CEPHEUS GPU: smmu IDR2 = %08x  IAS=%u bits OAS=%u bits PTFS 4K=%u 16K=%u 64K=%u\n", id2, bits[id2 & 7u], bits[(id2 >> 4) & 7u],
+	    (id2 >> 12) & 1u, (id2 >> 13) & 1u, (id2 >> 14) & 1u);
+	printf("CEPHEUS GPU: smmu IDR7 = %08x  version %u.%u\n", id7, (id7 >> 4) & 0xfu, id7 & 0xfu);
+	printf("CEPHEUS GPU: smmu sCR0 = %08x  sACR = %08x  sGFSR = %08x  sGFSYNR0 = %08x\n", gpu_srd(0x0u), gpu_srd(0x10u), gpu_srd(0x48u),
+	    gpu_srd(0x50u));
+	printf("CEPHEUS GPU: smmu: siguiente paso: g smmu map (SMR y S2CR), luego g smmu cb 0, 1, 2...\n");
+}
+
+static void
+gpu_smmu_map(void)
+{
+	struct gpu_smmu_geo g;
+	if (!gpu_smmu_ok() || !gpu_smmu_geo(&g)) {
+		return;
+	}
+	unsigned n = g.numsmrg > 48 ? 48 : g.numsmrg;
+	printf("CEPHEUS GPU: === smmu: %u grupos de stream (se muestran %u): smr / s2cr ===\n", g.numsmrg, n);
+	for (unsigned i = 0; i < n; i += 2) {
+		if (i + 1 < n) {
+			printf("CEPHEUS GPU: smr[%02u]=%08x s2cr=%08x | smr[%02u]=%08x s2cr=%08x\n", i, gpu_srd(0x800u + 4 * i), gpu_srd(0xc00u + 4 * i),
+			    i + 1, gpu_srd(0x800u + 4 * (i + 1)), gpu_srd(0xc00u + 4 * (i + 1)));
+		} else {
+			printf("CEPHEUS GPU: smr[%02u]=%08x s2cr=%08x\n", i, gpu_srd(0x800u + 4 * i), gpu_srd(0xc00u + 4 * i));
+		}
+	}
+}
+
+static void
+gpu_smmu_cb(const char *args)
+{
+	struct gpu_smmu_geo g;
+	uint32_t n;
+	if (!gpu_smmu_ok()) {
+		return;
+	}
+	while (*args == ' ') {
+		++args;
+	}
+	if (!gpu_hex(args, &n)) {
+		printf("CEPHEUS GPU: smmu cb: indica el numero del banco (por ejemplo: g smmu cb 0)\n");
+		return;
+	}
+	if (!gpu_smmu_geo(&g)) {
+		return;
+	}
+	uint32_t cb = (g.numpage + n) << g.pgshift, gr1 = 1u << g.pgshift;
+	if (n >= g.numcb || cb + 0x5cu > GPU_SMMU_SIZE || gr1 + 0x800u + 4 * n + 4 > GPU_SMMU_SIZE) {
+		printf("CEPHEUS GPU: smmu cb %u: no existe (NUMCB=%u) o cae fuera de la ventana\n", n, g.numcb);
+		return;
+	}
+	printf("CEPHEUS GPU: smmu: leyendo el banco %u (pagina %#x, GR1 %#x)\n", n, cb, gr1);
+	printf("CEPHEUS GPU: cb%u CBAR = %08x  CBA2R = %08x\n", n, gpu_srd(gr1 + 4 * n), gpu_srd(gr1 + 0x800u + 4 * n));
+	printf("CEPHEUS GPU: cb%u SCTLR = %08x  TCR = %08x  TCR2 = %08x  TTBR0 = %08x_%08x  MAIR0 = %08x  FSR = %08x\n", n, gpu_srd(cb),
+	    gpu_srd(cb + 0x30u), gpu_srd(cb + 0x10u), gpu_srd(cb + 0x24u), gpu_srd(cb + 0x20u), gpu_srd(cb + 0x38u), gpu_srd(cb + 0x58u));
+}
+
+static void
+gpu_smmu_cmd(const char *a)
+{
+	while (*a == ' ') {
+		++a;
+	}
+	if (*a == 0) {
+		gpu_smmu_global();
+	} else if (!strncmp(a, "map", 3) && (a[3] == 0 || a[3] == ' ')) {
+		gpu_smmu_map();
+	} else if (!strncmp(a, "cb", 2) && (a[2] == 0 || a[2] == ' ')) {
+		gpu_smmu_cb(a + 2);
+	} else {
+		printf("CEPHEUS GPU: smmu: g smmu | g smmu map | g smmu cb N\n");
+	}
+}
