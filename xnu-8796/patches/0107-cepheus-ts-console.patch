 	ts_dump_pins("after");
-	ts_pmic_scan();
+	ts_ready = ok && !perr;
 	printf("CEPHEUS TS: stage 1 %s\n", (ok && !perr) ? "complete" : "INCOMPLETE");
 	if (ts.stage < 2 || !ok || perr) {
 		goto out;
