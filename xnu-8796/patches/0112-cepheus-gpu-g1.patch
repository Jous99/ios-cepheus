@@ -163,6 +341,9 @@ gpu_window(uint32_t a)
 	if (a >= GPU_CC_PA && a + 4 <= GPU_CC_PA + GPU_CC_SIZE) {
 		return 2;
 	}
+	if (a >= GPU_GMU_PA && a + 4 <= GPU_GMU_PA + GPU_GMU_SIZE) {
