+		}
+		uint32_t v = w == 1 ? gpu_rd(gpu_gcc, a - GPU_GCC_PA) : w == 2 ? gpu_rd(gpu_cc, a - GPU_CC_PA) : gpu_rd(gpu_gmu, a - GPU_GMU_PA);
 		printf("CEPHEUS GPU: r %#09x = %08x\n", a, v);
