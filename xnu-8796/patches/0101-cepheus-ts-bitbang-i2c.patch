+/*
+ * Bit-banged I2C. The pull-ups are on the board, so a line is released by turning its output off (TLMM function 0,
+ * OE = 0) and driven low by turning the output on with the level latched at 0. About 100 kHz.
+ */
+#define TS_BB_US        5u
+#define TS_CFG_OE       0x200u
+
+static vm_offset_t ts_sda_va, ts_scl_va;
+static uint32_t ts_sda_cfg, ts_scl_cfg;     /* released state of each line */
+
+static void ts_sda_rel(void) { ts_wr(ts_sda_va, 0, ts_sda_cfg); }
+static void ts_sda_lo(void) { ts_wr(ts_sda_va, 0, ts_sda_cfg | TS_CFG_OE); }
+static unsigned ts_sda_rd(void) { return ts_rd(ts_sda_va, 4) & 1u; }
+static void ts_scl_rel(void) { ts_wr(ts_scl_va, 0, ts_scl_cfg); }
+static void ts_scl_lo(void) { ts_wr(ts_scl_va, 0, ts_scl_cfg | TS_CFG_OE); }
+static unsigned ts_scl_rd(void) { return ts_rd(ts_scl_va, 4) & 1u; }
+
+/* Release SCL and wait for it to go high (the IC may stretch the clock). */
+static bool
+ts_scl_hi(void)
+{
+	ts_scl_rel();
+	for (unsigned i = 0; i < 500; ++i) {
+		if (ts_scl_rd()) {
+			return true;
+		}
+		delay(2);
+	}
+	return false;
+}
+
+static bool
+ts_bb_init(bool swap)
+{
+	struct ts_pin *sda = ts_find(swap ? 56 : 55);
+	struct ts_pin *scl = ts_find(swap ? 55 : 56);
+	if (!sda || !scl || !sda->va || !scl->va) {
+		return false;
+	}
+	ts_sda_va = sda->va;
+	ts_scl_va = scl->va;
+	ts_wr(sda->va, 4, ts_rd(sda->va, 4) & ~2u);         /* output level latched low */
+	ts_wr(scl->va, 4, ts_rd(scl->va, 4) & ~2u);
+	ts_sda_cfg = ts_rd(sda->va, 0) & ~0x3ffu;           /* GPIO function, 2 mA, no pull, output off */
+	ts_scl_cfg = ts_rd(scl->va, 0) & ~0x3ffu;
+	ts_sda_rel();
+	ts_scl_rel();
+	delay(TS_BB_US);
+	return true;
+}
+
+/* Free a bus held by a half-finished transfer: up to 9 clocks, then a STOP. */
+static void
+ts_bb_recover(void)
+{
+	ts_sda_rel();
+	(void)ts_scl_hi();
+	delay(TS_BB_US);
+	for (unsigned i = 0; i < 9 && !ts_sda_rd(); ++i) {
+		ts_scl_lo();
+		delay(TS_BB_US);
+		(void)ts_scl_hi();
+		delay(TS_BB_US);
+	}
+	ts_sda_lo();
+	delay(TS_BB_US);
+	(void)ts_scl_hi();
+	delay(TS_BB_US);
+	ts_sda_rel();
+	delay(TS_BB_US);
+}
+
+static int
+ts_bb_start(void)
+{
+	ts_sda_rel();
+	if (!ts_scl_hi()) {
+		return ETIMEDOUT;
+	}
+	delay(TS_BB_US);
+	if (!ts_sda_rd()) {
+		return EBUSY;
+	}
+	ts_sda_lo();
+	delay(TS_BB_US);
+	ts_scl_lo();
+	delay(TS_BB_US);
+	return 0;
+}
+
+static void
+ts_bb_stop(void)
+{
+	ts_sda_lo();
+	delay(TS_BB_US);
+	(void)ts_scl_hi();
+	delay(TS_BB_US);
+	ts_sda_rel();
+	delay(TS_BB_US);
+}
+
+/* One byte out; returns 0 on ACK, ENXIO on NACK, ETIMEDOUT when SCL is held low. */
+static int
+ts_bb_write(uint8_t b)
+{
+	for (int i = 7; i >= 0; --i) {
+		if (b & (1u << i)) {
+			ts_sda_rel();
+		} else {
+			ts_sda_lo();
+		}
+		delay(TS_BB_US);
+		if (!ts_scl_hi()) {
+			return ETIMEDOUT;
+		}
+		delay(TS_BB_US);
+		ts_scl_lo();
+	}
+	ts_sda_rel();
+	delay(TS_BB_US);
+	if (!ts_scl_hi()) {
+		return ETIMEDOUT;
+	}
+	delay(TS_BB_US);
+	unsigned nack = ts_sda_rd();
+	ts_scl_lo();
+	delay(TS_BB_US);
+	return nack ? ENXIO : 0;
+}
+
+static int
+ts_bb_read(uint8_t *b, bool ack)
+{
+	uint8_t v = 0;
+	ts_sda_rel();
+	for (int i = 0; i < 8; ++i) {
+		delay(TS_BB_US);
+		if (!ts_scl_hi()) {
+			return ETIMEDOUT;
+		}
+		delay(TS_BB_US);
+		v = (uint8_t)((v << 1) | ts_sda_rd());
+		ts_scl_lo();
+	}
+	if (ack) {
+		ts_sda_lo();
+	}
+	delay(TS_BB_US);
+	if (!ts_scl_hi()) {
+		return ETIMEDOUT;
+	}
+	delay(TS_BB_US);
+	ts_scl_lo();
+	ts_sda_rel();
+	*b = v;
+	return 0;
+}
+
+/* START, address (write), nt bytes, then (if nr) repeated START, address (read) and nr bytes, STOP. */
+static int
+ts_bb_xfer(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr)
+{
+	int err = ts_bb_start();
+	if (err) {
+		ts_bb_recover();
+		return err;
+	}
+	err = ts_bb_write((uint8_t)(addr << 1));
+	for (unsigned i = 0; !err && i < nt; ++i) {
+		err = ts_bb_write(tx[i]);
+	}
+	if (!err && nr) {
+		err = ts_bb_start();
+		if (!err) {
+			err = ts_bb_write((uint8_t)((addr << 1) | 1u));
+		}
+		for (unsigned i = 0; !err && i < nr; ++i) {
+			err = ts_bb_read(&rx[i], i + 1 < nr);
+		}
+	}
+	if (err == ETIMEDOUT || err == EBUSY) {
+		ts_bb_recover();
+	} else {
+		ts_bb_stop();
+	}
+	return err;
+}
+
+/* Stage 2: both lines idle high and each follows a wiggle. Nothing is sent to the IC. */
+static bool
+ts_bb_selftest(void)
+{
+	if (!ts_bb_init(false)) {
+		printf("CEPHEUS TS: bit-bang init failed\n");
+		return false;
+	}
+	unsigned sda0 = ts_sda_rd(), scl0 = ts_scl_rd();
+	ts_scl_lo();
+	delay(20);
+	unsigned scl_low = ts_scl_rd();
+	ts_scl_rel();
+	delay(20);
+	unsigned scl_hi = ts_scl_rd();
+	ts_sda_lo();
+	delay(20);
+	unsigned sda_low = ts_sda_rd();
+	ts_sda_rel();
+	delay(20);
+	unsigned sda_hi = ts_sda_rd();
+	printf("CEPHEUS TS: bus idle sda %u scl %u | wiggle: scl low %u released %u, sda low %u released %u\n",
+	    sda0, scl0, scl_low, scl_hi, sda_low, sda_hi);
+	return sda0 && scl0 && !scl_low && scl_hi && !sda_low && sda_hi;
+}
+
+/* Look for an ACK from 0x49 with SDA/SCL as gpio55/56, then swapped. Returns 0 or 1 (swapped), or -1. */
+static int
+ts_bb_find(bool verbose)
+{
+	for (unsigned swap = 0; swap < 2; ++swap) {
+		if (!ts_bb_init(swap != 0)) {
+			continue;
+		}
+		ts_bb_recover();
+		int err = ts_bb_xfer(TS_ADDR, NULL, 0, NULL, 0);
+		if (verbose || !err) {
+			printf("CEPHEUS TS: probe 0x49 with sda=gpio%u scl=gpio%u: %s (err %d)\n", swap ? 56u : 55u,
+			    swap ? 55u : 56u, err ? "no ack" : "ACK", err);
+		}
+		if (!err) {
+			return (int)swap;
+		}
+	}
+	return -1;
+}
+
 /* Write one command byte, then read len bytes after a repeated START (FTS "writeRead"). */
 static int
 ts_read(uint8_t cmd, uint8_t *buf, unsigned len)
 {
+	if (!ts_use_geni) {
+		return ts_bb_xfer(TS_ADDR, &cmd, 1u, buf, len);
+	}
 	int err = ts_msg(TS_ADDR, &cmd, 1u, NULL, 0, true);
 	if (err) {
 		return err;
@@ -396,6 +637,9 @@ ts_read(uint8_t cmd, uint8_t *buf, unsigned len)
 static int
 ts_write_cmd(uint8_t cmd)
 {
+	if (!ts_use_geni) {
+		return ts_bb_xfer(TS_ADDR, &cmd, 1u, NULL, 0);
+	}
 	return ts_msg(TS_ADDR, &cmd, 1u, NULL, 0, false);
 }
 
