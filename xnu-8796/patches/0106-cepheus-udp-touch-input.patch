diff --git a/bsd/dev/cepheus_usb.c b/bsd/dev/cepheus_usb.c
index ce10dba..244445f 100644
--- a/bsd/dev/cepheus_usb.c
+++ b/bsd/dev/cepheus_usb.c
@@ -848,6 +848,113 @@ ud_log_thread(void *arg __unused, wait_result_t wr __unused)
