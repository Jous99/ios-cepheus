  * Bit-banged I2C. The pull-ups are on the board, so a line is released by turning its output off (TLMM function 0,
  * OE = 0) and driven low by turning the output on with the level latched at 0. About 100 kHz.
  */
-#define TS_BB_US        5u
+#define TS_BB_US        20u
 #define TS_CFG_OE       0x200u
 
 static vm_offset_t ts_sda_va, ts_scl_va;
@@ -416,6 +416,15 @@ ts_scl_hi(void)
 	return false;
 }
 
+/* Wait for SDA to be pulled up after it was released (the rise can be slow). */
+static void
+ts_sda_wait_hi(void)
+{
+	for (unsigned i = 0; i < 200 && !ts_sda_rd(); ++i) {
+		delay(2);
+	}
+}
+
 static bool
 ts_bb_init(bool swap)
 {
@@ -465,6 +474,7 @@ ts_bb_start(void)
 		return ETIMEDOUT;
 	}
 	delay(TS_BB_US);
+	ts_sda_wait_hi();
 	if (!ts_sda_rd()) {
 		return EBUSY;
 	}
@@ -493,6 +503,7 @@ ts_bb_write(uint8_t b)
 	for (int i = 7; i >= 0; --i) {
 		if (b & (1u << i)) {
 			ts_sda_rel();
+			ts_sda_wait_hi();
 		} else {
 			ts_sda_lo();
 		}
@@ -573,6 +584,30 @@ ts_bb_xfer(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned n
 	return err;
 }
 
+/* Microseconds a released line takes to read high after being driven low for 30 us (400 = never). */
+static unsigned
+ts_rise_us(bool sda)
+{
+	if (sda) {
+		ts_sda_lo();
+	} else {
+		ts_scl_lo();
+	}
+	delay(30);
+	if (sda) {
+		ts_sda_rel();
+	} else {
+		ts_scl_rel();
+	}
+	for (unsigned us = 0; us < 400; ++us) {
+		if (sda ? ts_sda_rd() : ts_scl_rd()) {
+			return us;
+		}
+		delay(1);
+	}
+	return 400;
+}
