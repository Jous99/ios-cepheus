+	unsigned rise_sda = ts_rise_us(true), rise_scl = ts_rise_us(false);
+	printf("CEPHEUS TS: rise time after release: sda %u us, scl %u us (half bit is %u us)\n", rise_sda, rise_scl, TS_BB_US);
 	return sda0 && scl0 && !scl_low && scl_hi && !sda_low && sda_hi;
 }
 
