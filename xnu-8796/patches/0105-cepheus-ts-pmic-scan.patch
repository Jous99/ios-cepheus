+/* Read only: type, status and enable of the PM8150L (SID 4) regulator blocks, to see whether avdd (ldoc1) is really on. */
+static void
+ts_pmic_scan(void)
+{
+	int init = cepheus_spmi_init();
+	printf("CEPHEUS TS: pmic access: spmi init %d\n", init);
+	for (unsigned p = 0x40; p <= 0x4f; ++p) {
+		uint8_t type = 0xff, sub = 0xff, st = 0xff, en = 0xff, v1 = 0xff, v2 = 0xff;
+		int e0 = cepheus_spmi_read(4, (p << 8) | 0x04, &type);
+		(void)cepheus_spmi_read(4, (p << 8) | 0x05, &sub);
+		(void)cepheus_spmi_read(4, (p << 8) | 0x08, &st);
+		(void)cepheus_spmi_read(4, (p << 8) | 0x46, &en);
+		(void)cepheus_spmi_read(4, (p << 8) | 0x40, &v1);
+		(void)cepheus_spmi_read(4, (p << 8) | 0x41, &v2);
+		printf("CEPHEUS TS: pm8150l %#x: type %02x sub %02x status1 %02x en_ctl %02x vset %02x%02x (err %d)\n", p << 8, type, sub,
+		    st, en, v2, v1, e0);
+	}
+}
