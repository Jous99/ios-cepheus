+/* One 8-byte event. Touch events: type, finger in the low nibble of byte 1, x and y packed in bytes 2 to 4. */
+static void
+ts_parse_event(const uint8_t *ev, uint32_t *mask, int *x, int *y)
+{
+	unsigned id = ev[1] & 0x0fu;
+	if ((ev[0] == TS_EV_ENTER || ev[0] == TS_EV_MOTION) && id < TS_MAX) {
+		x[id] = (int)((((unsigned)ev[3] & 0x0fu) << 8) | ev[2]);
+		y[id] = (int)(((unsigned)ev[4] << 4) | (ev[3] >> 4));
+		*mask |= 1u << id;
+	} else if (ev[0] == TS_EV_LEAVE && id < TS_MAX) {
+		*mask &= ~(1u << id);
+	} else if (ev[0] == TS_EV_READY) {
+		ts_rescan = true;
+	}
+}
