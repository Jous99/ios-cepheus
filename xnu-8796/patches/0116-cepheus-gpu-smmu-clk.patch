+		gpu_smmu_clk();
 	} else {
-		printf("CEPHEUS GPU: smmu: g smmu | g smmu map | g smmu cb N | g smmu wtest | g smmu gtest\n");
+		printf("CEPHEUS GPU: smmu: g smmu | g smmu map | g smmu cb N | g smmu wtest | g smmu gtest [valid] | g smmu clk\n");
 	}
