+/*
+ * G2b-2: the "mem" clock of the SMMU. The device tree lists three clocks for it (iface, mem, mem_iface) and Linux enables
+ * all of them before any register access. iface (gcc_gpu_cfg_ahb_clk) and mem_iface (gcc_gpu_memnoc_gfx_clk) are already
+ * running; mem (gcc_ddrss_gpu_axi_clk, CBCR at 0x71154) was off. Its halt status is polled like in Linux.
+ */
+static void
+gpu_smmu_clk(void)
+{
+	if (!gpu_smmu_ok()) {
+		return;
+	}
+	uint32_t before = gpu_rd(gpu_gcc, 0x71154u);
+	if (!gpu_wr_gcc(0x71154u, before | GPU_CBCR_EN)) {
+		return;
+	}
+	bool on = gpu_poll(gpu_gcc, 0x71154u, GPU_CBCR_OFF, 0, 1000);
+	printf("CEPHEUS GPU: gcc 0x71154 gcc_ddrss_gpu_axi_clk: %08x -> %08x: %s\n", before, gpu_rd(gpu_gcc, 0x71154u),
+	    on ? "EN MARCHA" : "SIGUE DETENIDO (clk_off=1)");
+}
