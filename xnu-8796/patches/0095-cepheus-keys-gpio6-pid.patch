+/* Mi 9: volume-up is GPIO6 of the PM8150 at SID 0 (cepheus.dts: vol_up gpios = <&pm8150_gpios 6 ACTIVE_LOW>).
+ * The qcom,spmi-gpio DT cell is 1-based, so GPIOn lives at peripheral 0xc0 + (n - 1): the DT interrupt list
+ * for pm8150_gpio6 is PID 0xc5. Registers: block base 0xc500, INT_RT_STS +0x10, MODE_CTL +0x40, EN_CTL +0x46.
+ * (0084 used the 0-based index and PPID 0x0c0, i.e. read the wrong pin.) */
+#define KEYS_GPIO_PPID   0x0c5u
+#define KEYS_GPIO_RT     0xc510u
+#define KEYS_GPIO_MODE   0xc540u
+#define KEYS_GPIO_EN     0xc546u
+#define KEYS_GPIO_SUBTYPE 0xc505u
 #define KEYS_NO_APID     0xffffu
 
 static vm_offset_t keys_core, keys_obs, keys_cnfg;
@@ -120,7 +121,7 @@ keys_thread(void *arg, wait_result_t result)
