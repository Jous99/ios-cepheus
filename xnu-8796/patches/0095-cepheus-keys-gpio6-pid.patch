 #define KEYS_OBS_PA      0x0e600000u
 #define KEYS_CNFG_PA     0x0c40a000u
 #define KEYS_PON_RT      0x0810u
-/* Mi 9: volume-up is GPIO6 (0-based DT cell 6) of the PM8150 at SID 0, not
- * PM6150L GPIO2 at SID 4. Offsets: block base 0xc000 + 0x100 * pin.
- * NOT yet verified on hardware (see KEYS diagnostic line in the boot log). */
-#define KEYS_GPIO_PPID   0x0c0u
-#define KEYS_GPIO_RT     0xc610u
-#define KEYS_GPIO_MODE   0xc640u
-#define KEYS_GPIO_EN     0xc646u
