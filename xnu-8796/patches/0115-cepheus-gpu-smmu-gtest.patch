  * at reset), a FAULT type for S2CR, an invalid SMR and a write-one-to-clear of FSR: what arm_smmu_device_reset() writes.
  */
 #define GPU_SMMU_CB1    0x9000u
+#define GPU_SMMU_NSMRG  6u                  /* NUMSMRG of this SMMU, read by g smmu */
 
 static bool
-gpu_wr_smmu(uint32_t off, uint32_t val)
