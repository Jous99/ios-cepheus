-		printf("CEPHEUS GPU: smmu: g smmu | g smmu map | g smmu cb N | g smmu wtest\n");
+		printf("CEPHEUS GPU: smmu: g smmu | g smmu map | g smmu cb N | g smmu wtest | g smmu gtest\n");
