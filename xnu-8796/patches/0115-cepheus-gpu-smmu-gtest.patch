+	}
+	if ((off >= 0x800u && off < 0x800u + 4 * GPU_SMMU_NSMRG) || (off >= 0xc00u && off < 0xc00u + 4 * GPU_SMMU_NSMRG)) {
+		return true;                        /* SMR[n] and S2CR[n] */
