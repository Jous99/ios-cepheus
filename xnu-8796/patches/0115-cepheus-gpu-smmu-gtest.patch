+static bool
+gpu_wr_smmu(uint32_t off, uint32_t val)
+{
+	if (!gpu_smmu_wr_ok(off)) {
+		printf("CEPHEUS GPU: escritura rechazada: smmu %#06x no esta en la lista\n", off);
+		return false;
+	}
+	*(volatile uint32_t *)(gpu_smmu + off) = val;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return true;
