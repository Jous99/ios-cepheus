+/*
+ * G2b-1: which stream groups take writes? G2b-0 showed that S2CR[0] ignores a write, and left SMR[0] untested (it held
+ * zero and zero was written). For each group: a value that differs from the current one (an SMR with VALID = 0, so that it
+ * can never match traffic, and an S2CR of type FAULT with another bank), read back, and then the original is written
+ * back. A register is taken as writable if it changed. Refuses to run unless the six SMRs are all invalid.
+ */
+static void
+gpu_smmu_gtest(void)
+{
+	struct gpu_smmu_geo g;
+	unsigned smr_w = 0, s2cr_w = 0, both = 0;
+	if (!gpu_smmu_ok() || !gpu_smmu_geo(&g)) {
+		return;
+	}
+	if (g.numsmrg != GPU_SMMU_NSMRG) {
+		printf("CEPHEUS GPU: gtest rechazado: NUMSMRG = %u y se esperaban %u\n", g.numsmrg, GPU_SMMU_NSMRG);
+		return;
+	}
+	for (unsigned n = 0; n < GPU_SMMU_NSMRG; ++n) {
+		if (gpu_srd(0x800u + 4 * n) & (1u << 31)) {
+			printf("CEPHEUS GPU: gtest rechazado: el SMR %u es valido (hay un stream asignado)\n", n);
+			return;
+		}
+	}
+	printf("CEPHEUS GPU: === G2b-1: prueba de escritura en los %u grupos de stream ===\n", GPU_SMMU_NSMRG);
+	for (unsigned n = 0; n < GPU_SMMU_NSMRG; ++n) {
+		uint32_t so = 0x800u + 4 * n, co = 0xc00u + 4 * n;
+		uint32_t smr0 = gpu_srd(so), s2cr0 = gpu_srd(co);
+		printf("CEPHEUS GPU: grupo %u: probando (SMR %08x, S2CR %08x)\n", n, smr0, s2cr0);
+		gpu_wr_smmu(so, 0x04000005u);                       /* VALID = 0, MASK = 0x400, ID = 5 */
+		uint32_t smr1 = gpu_srd(so);
+		gpu_wr_smmu(co, 0x00020001u);                       /* TYPE = FAULT, CBNDX = 1 */
+		uint32_t s2cr1 = gpu_srd(co);
+		gpu_wr_smmu(so, smr0);                              /* put back what was there */
+		gpu_wr_smmu(co, s2cr0);
+		bool sw = smr1 != smr0, cw = s2cr1 != s2cr0;
+		smr_w += sw;
+		s2cr_w += cw;
+		both += sw && cw;
+		printf("CEPHEUS GPU:   SMR %08x -> %08x (%s) | S2CR %08x -> %08x (%s) | restaurado: SMR %08x S2CR %08x\n", smr0, smr1,
+		    sw ? "ACEPTA" : "ignora", s2cr0, s2cr1, cw ? "ACEPTA" : "ignora", gpu_srd(so), gpu_srd(co));
+	}
+	printf("CEPHEUS GPU: === G2b-1: SMR acepta escrituras en %u de %u grupos, S2CR en %u de %u, los dos en %u ===\n", smr_w,
+	    GPU_SMMU_NSMRG, s2cr_w, GPU_SMMU_NSMRG, both);
+}
