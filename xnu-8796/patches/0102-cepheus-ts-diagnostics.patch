+/* FTS hardware register read: write B6 hi lo, then read n + 1 bytes (the first one is a dummy). */
+static int
+ts_hwreg(uint16_t addr, uint8_t *out, unsigned n)
+{
+	uint8_t cmd[3] = { 0xb6, (uint8_t)(addr >> 8), (uint8_t)addr };
+	uint8_t tmp[8] = { 0 };
+	if (n > 7) {
+		return EIO;
+	}
+	int err = ts_bb_xfer(TS_ADDR, cmd, 3u, tmp, n + 1u);
+	if (!err) {
+		for (unsigned i = 0; i < n; ++i) {
+			out[i] = tmp[i + 1];
+		}
+	}
+	return err;
+}
